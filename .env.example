# Режим работы (DEV, PROD, TEST)
MODE=DEV

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Настройки основной базы данных
DB_USER=ваш_юзернейм
DB_PASS=ваш_пароль
DB_HOST=localhost
DB_PORT=порт
DB_NAME=ваше_название_бд

# Настройки тестовой базы данных
TEST_DB_USER=ваш_юзернейм
TEST_DB_PASS=ваш_пароль
TEST_DB_HOST=localhost
TEST_DB_PORT=порт
TEST_DB_NAME=ваше_название_бд

# Настройки парсера (опционально)
PARSER_TIMEOUT=30
PARSER_HEADLESS=True

# Telegram Bot (опционально - для запуска бота)
TELEGRAM_TOKEN=ваш_telegram_token_здесь
TELEGRAM_CHAT_ID=ваш_chat_id_здесь
